<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Main</AssemblyName>
    <RootNamespace>Fantasy</RootNamespace>
    <DebugType>portable</DebugType>
    <!-- Main 使用 Entity 的配置，避免三个项目维护三份启服配置。 -->
    <IsDirectFantasyNetReference>false</IsDirectFantasyNetReference>
    <FantasyConfigAutoDiscoveryEnabled>false</FantasyConfigAutoDiscoveryEnabled>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Entity\Entity.csproj" />
    <ProjectReference Include="..\Hotfix\Hotfix.csproj" ReferenceOutputAssembly="false" />
    <PackageReference Include="Fantasy-Net" Version="$(FantasyNetVersion)" />
    <PackageReference Include="NLog" Version="5.4.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\Entity\Fantasy.config" Link="Fantasy.config" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\Entity\Fantasy.xsd" Link="Fantasy.xsd" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="NLog.config" CopyToOutputDirectory="PreserveNewest" />
    <None Update="NLog.xsd" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CopyHotfixArtifacts" AfterTargets="Build">
    <ItemGroup>
      <HotfixArtifacts Include="..\Hotfix\bin\$(Configuration)\$(TargetFramework)\Hotfix.dll" />
      <HotfixArtifacts Include="..\Hotfix\bin\$(Configuration)\$(TargetFramework)\Hotfix.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(HotfixArtifacts)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyHotfixArtifactsToPublish" AfterTargets="Publish">
    <ItemGroup>
      <HotfixPublishArtifacts Include="..\Hotfix\bin\$(Configuration)\$(TargetFramework)\Hotfix.dll" />
      <HotfixPublishArtifacts Include="..\Hotfix\bin\$(Configuration)\$(TargetFramework)\Hotfix.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(HotfixPublishArtifacts)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
