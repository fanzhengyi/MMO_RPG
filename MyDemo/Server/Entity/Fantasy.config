<?xml version="1.0" encoding="utf-8" ?>
<fantasy xmlns="http://fantasy.net/config"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://fantasy.net/config Fantasy.xsd">
	<!-- ↓这是为了兼容旧版Fantasy的导表Json配置↓, 如果这个XML节点被注释掉, 就会以 Fantasy.config 配置为准 -->
	<!--<configTable path="../../../../Config/Json/Server" />-->
	<!-- ↓这是目前推荐使用的Fantasy框架启服配置↓ -->
	<network inner="TCP" maxMessageSize="1048560" />
	<session idleTimeout="8000" idleInterval="5000" />
	<server>
		<!-- 机器配置 -->
		<machines>
			<machine id="1" outerIP="127.0.0.1" outerBindIP="0.0.0.0" innerBindIP="127.0.0.1" />
		</machines>
		<!-- 进程配置 -->
		<processes>
			<!-- 进程1(鉴权) -->
			<process id="1" machineId="1" startupGroup="0" />
			<!-- 进程2（Gate） -->
			<process id="2" machineId="1" startupGroup="0" />
			<!-- 进程3（GameServer） -->
			<process id="3" machineId="1" startupGroup="0" />
		</processes>
		<!-- 世界配置 -->
		<worlds>
			<world id="1" worldName="WorldA" >
				<database dbType="MongoDB" dbName="fantasy_main" dbConnection="mongodb://127.0.0.1:27017"/>
			</world>
		</worlds>
		<!-- 场景配置 -->
		<scenes>
			<!-- 登录服务器 -->
			<scene id="1001"
				   processConfigId="1"
				   worldConfigId="1"
				   sceneRuntimeMode="MultiThread"
				   sceneTypeString="Authentication"
				   networkProtocol="KCP"
				   outerPort="20001" innerPort="11001" />
			<scene id="1002"
			   processConfigId="1"
			   worldConfigId="1"
			   sceneRuntimeMode="MultiThread"
			   sceneTypeString="Authentication"
			   networkProtocol="KCP"
			   outerPort="20002" innerPort="11002" />
			<scene id="1003"
			   processConfigId="1"
			   worldConfigId="1"
			   sceneRuntimeMode="MultiThread"
			   sceneTypeString="Authentication"
			   networkProtocol="KCP"
			   outerPort="20003" innerPort="11003" />

			<!-- Gate服务器 -->
			<scene id="1050"
			   processConfigId="2"
			   worldConfigId="1"
			   sceneRuntimeMode="MultiThread"
			   sceneTypeString="Gate"
			   networkProtocol="KCP"
			   outerPort="20050" innerPort="11050" />
			<scene id="1051"
			   processConfigId="2"
			   worldConfigId="1"
			   sceneRuntimeMode="MultiThread"
			   sceneTypeString="Gate"
			   networkProtocol="KCP"
			   outerPort="20051" innerPort="11051" />
			
			<!-- 游戏服务器（不接客户端，outerPort=0） -->
			<scene id="1110"
			   processConfigId="3"
			   worldConfigId="1"
			   sceneRuntimeMode="MultiThread"
			   sceneTypeString="Game"
			   networkProtocol="KCP"
			   outerPort="0" innerPort="21001" />
			
		</scenes>
	</server>
</fantasy>